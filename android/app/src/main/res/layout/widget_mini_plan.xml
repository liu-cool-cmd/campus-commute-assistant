<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <LinearLayout android:id="@+id/widget_mini_header" style="@style/CommuteWidgetHeader">
        <TextView android:id="@+id/widget_mini_brand" style="@style/CommuteWidgetBadge" />

        <TextView
            android:id="@+id/widget_mini_title"
            style="@style/CommuteWidgetTitle"
            android:text="Mini schedule" />
    </LinearLayout>

    <ImageView style="@style/CommuteWidgetSpacer" />

    <!-- Row count must match MINI_ROWS in CommuteWidgetProvider.java. -->
    <LinearLayout
        android:id="@+id/widget_mini_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/widget_mini_row_1" style="@style/CommuteWidgetMiniRow">
            <TextView android:id="@+id/widget_mini_day_1" style="@style/CommuteWidgetMiniDay" android:text="Today" />
            <TextView android:id="@+id/widget_mini_time_1" style="@style/CommuteWidgetMiniTime" android:text="9:31" />
            <TextView android:id="@+id/widget_mini_title_1" style="@style/CommuteWidgetMiniTitle" android:text="Calculus II" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_mini_row_2" style="@style/CommuteWidgetMiniRow">
            <TextView android:id="@+id/widget_mini_day_2" style="@style/CommuteWidgetMiniDay" android:text="Today" />
            <TextView android:id="@+id/widget_mini_time_2" style="@style/CommuteWidgetMiniTime" android:text="13:20" />
            <TextView android:id="@+id/widget_mini_title_2" style="@style/CommuteWidgetMiniTitle" android:text="Computer Science 201" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_mini_row_3" style="@style/CommuteWidgetMiniRow">
            <TextView android:id="@+id/widget_mini_day_3" style="@style/CommuteWidgetMiniDay" android:text="Wed 23" />
            <TextView android:id="@+id/widget_mini_time_3" style="@style/CommuteWidgetMiniTime" android:text="8:05" />
            <TextView android:id="@+id/widget_mini_title_3" style="@style/CommuteWidgetMiniTitle" android:text="Linear Algebra" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_mini_row_4" style="@style/CommuteWidgetMiniRow" android:visibility="gone">
            <TextView android:id="@+id/widget_mini_day_4" style="@style/CommuteWidgetMiniDay" />
            <TextView android:id="@+id/widget_mini_time_4" style="@style/CommuteWidgetMiniTime" />
            <TextView android:id="@+id/widget_mini_title_4" style="@style/CommuteWidgetMiniTitle" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_mini_row_5" style="@style/CommuteWidgetMiniRow" android:visibility="gone">
            <TextView android:id="@+id/widget_mini_day_5" style="@style/CommuteWidgetMiniDay" />
            <TextView android:id="@+id/widget_mini_time_5" style="@style/CommuteWidgetMiniTime" />
            <TextView android:id="@+id/widget_mini_title_5" style="@style/CommuteWidgetMiniTitle" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_mini_row_6" style="@style/CommuteWidgetMiniRow" android:visibility="gone">
            <TextView android:id="@+id/widget_mini_day_6" style="@style/CommuteWidgetMiniDay" />
            <TextView android:id="@+id/widget_mini_time_6" style="@style/CommuteWidgetMiniTime" />
            <TextView android:id="@+id/widget_mini_title_6" style="@style/CommuteWidgetMiniTitle" />
        </LinearLayout>

        <LinearLayout android:id="@+id/widget_mini_row_7" style="@style/CommuteWidgetMiniRow" android:visibility="gone">
            <TextView android:id="@+id/widget_mini_day_7" style="@style/CommuteWidgetMiniDay" />
            <TextView android:id="@+id/widget_mini_time_7" style="@style/CommuteWidgetMiniTime" />
            <TextView android:id="@+id/widget_mini_title_7" style="@style/CommuteWidgetMiniTitle" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_mini_empty"
        style="@style/CommuteWidgetEmpty"
        android:text="No upcoming commute plan"
        android:visibility="gone" />

    <ImageView style="@style/CommuteWidgetSpacer" />

    <TextView
        android:id="@+id/widget_mini_footer"
        style="@style/CommuteWidgetFooter"
        android:visibility="gone" />
</LinearLayout>
