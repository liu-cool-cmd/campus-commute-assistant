<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <LinearLayout style="@style/CommuteWidgetHeader">
        <TextView style="@style/CommuteWidgetBadge" />

        <TextView
            android:id="@+id/widget_title"
            style="@style/CommuteWidgetTitle"
            android:text="Next commute" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_next_class"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Calculus II"
        android:textColor="@color/widget_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView style="@style/CommuteWidgetSpacer" />

    <TextView
        android:id="@+id/widget_next_empty"
        style="@style/CommuteWidgetEmpty"
        android:text="No upcoming commute plan"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_next_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_next_leave_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Leave"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <!-- Autosized to fill the width, so the number grows with the card instead of the card
             filling the gap with empty space. -->
        <TextView
            android:id="@+id/widget_next_leave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="60sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="9:21"
            android:textColor="@color/widget_accent"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_next_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="10:05 · CIEMAS 2240"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_next_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="C1 · 9:25"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp" />

    <ImageView
        android:id="@+id/widget_next_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="@color/widget_stroke"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_next_then"
        style="@style/CommuteWidgetThen"
        android:text="Up next"
        android:visibility="gone" />

    <ImageView style="@style/CommuteWidgetSpacer" />

    <TextView
        android:id="@+id/widget_next_footer"
        style="@style/CommuteWidgetFooter"
        android:visibility="gone" />
</LinearLayout>
